    "name": "keeps cursor cli priority over JUNIE_SHIM_PATH",
    "env": { "JUNIE_SHIM_PATH": "/tmp/junie/shim", "CURSOR_AGENT": "1" },
    "expectedIsAgent": true,
    "expectedAgentKey": "CURSOR_CLI"
  },

